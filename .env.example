# Server
HOST=0.0.0.0
PORT=8000
DEBUG=false

# Database (SQLite fallback, or postgresql)
DATABASE_URL=sqlite:///./data/certificates.db

# Storage
MAX_FILE_SIZE_MB=25

# Firebase Configuration
USE_FIREBASE=true
FIREBASE_PROJECT_ID=your-new-firebase-project-id
FIREBASE_STORAGE_BUCKET=your-new-firebase-project-id.firebasestorage.app

# Option A: Path to service account key file (local dev or Render Secret File)
FIREBASE_KEY_PATH=firebase-key.json

# Option B: Raw JSON string of the service account key (recommended for Render environment variables)
# FIREBASE_KEY_JSON={"type": "service_account", "project_id": "...", ...}

# Google Sheets API Integration (Optional: service account file or JSON, or API key)
# GOOGLE_SERVICE_ACCOUNT_FILE=/path/to/service-account.json
# GOOGLE_SERVICE_ACCOUNT_JSON={"type": "service_account", ...}
# GOOGLE_API_KEY=AIzaSy...

# CORS (Frontend URLs allowed to connect)
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","*"]

